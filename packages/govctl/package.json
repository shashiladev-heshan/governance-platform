{
  "name": "@shashiladev-heshan/govctl",
  "version": "0.1.1",
  "description": "Governance CLI — sync, verify, and restore centrally managed skills, policies and configs",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "govctl": "./dist/index.js"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "trust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashiladev-heshan/governance-platform.git",
    "directory": "packages/govctl"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@shashiladev-heshan/policy-core": "^0.1.1",
    "commander": "^12.1.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
